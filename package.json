{
  "name": "ruby-raider",
  "version": "4.0.0",
  "description": "Desktop app for Ruby Raider",
  "main": "./out/main/index.js",
  "author": "Augustin Gottlieb Pequeno",
  "homepage": "https://github.com/RaiderHQ",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && (chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true)",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "test": "vitest",
    "build:e2e": "electron-vite build --mode e2e",
    "test:e2e": "npm run build:e2e && npx playwright test",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/lodash": "^4.17.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "fix-path": "^4.0.0",
    "i18next": "^23.16.4",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react-hot-toast": "^2.5.1",
    "react-i18next": "^15.1.0",
    "react-icons": "^5.3.0",
    "react-router": "^7.18.5",
    "recharts": "^2.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.32",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "sucrase": {
      "glob": "^14.0.2"
    }
  }
}
